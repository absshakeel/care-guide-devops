aws_region            = "us-east-1"
environment           = "production"
ami_id                = "ami-000d209a4fc9822c4"   # Amazon Linux 2023 kernel-default x86_64, us-east-1 (2023.12.20261127.0)
instance_type         = "t3.small"
allowed_ingress_cidrs = ["0.0.0.0/0"]   # restrict to known CIDRs in real production
github_org            = "absshakeel"
github_repo           = "care-guide-devops"
create_oidc_provider  = false

# Optional. Leave empty to look up the account's existing GitHub OIDC provider
# by URL, or paste the provider ARN to skip the data-source lookup:
#   terraform -chdir=environments/staging output -raw github_oidc_provider_arn
oidc_provider_arn = ""

