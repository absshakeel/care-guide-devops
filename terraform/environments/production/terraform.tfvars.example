aws_region            = "us-east-1"
environment           = "production"
ami_id                = "ami-0c02fb55956c7d316"
instance_type         = "t3.small"
allowed_ingress_cidrs = ["0.0.0.0/0"]   # restrict to known CIDRs in real production
github_org            = "YOUR_GITHUB_ORG"
github_repo           = "care-guide-devops"

# Optional. The account's GitHub OIDC provider is created by the staging stack.
# Leave empty to look it up by URL, or paste `terraform output -raw
# github_oidc_provider_arn` from staging to avoid a data-source lookup.
oidc_provider_arn = ""

