aws_region    = "us-east-1"
environment   = "staging"
ami_id        = "ami-0c02fb55956c7d316"   # Amazon Linux 2023 us-east-1 — verify before apply
instance_type = "t3.micro"
github_org    = "absshakeel"
github_repo   = "care-guide-devops"

# The us-east-1 account already holds a GitHub OIDC provider created on
# 2026-10-21, and an account may hold only one per URL. Leave this false to
# reuse it; set true only on a clean account with no provider yet.
create_oidc_provider = false

