# Application configuration
PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development
APP_VERSION=0.1.0

# Grafana credentials (monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_before_deploy

# Loki configuration
LOKI_RETENTION_PERIOD=744h

# AWS (used locally only — CI/CD uses OIDC, never commit real values)
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REPOSITORY=careguide-app
